DEBUG=True
SENTRY_DSN=

ALLOWED_HOSTS=["http://localhost:4000"]
SITE_URL=http://localhost:4000

# Search engine endpoint
SEAR_XNG_URL=http://127.0.0.1:8001
SEAR_XNG_SAFE=1
CONTEXTS_LIMIT=8

# LLM backend endpoint
OLLAMA_URL=127.0.0.1:11434

# Optional basic auth for upstream proxy, e.g. user:pass
PROXY_AUTH=

# OpenAI-compatible LLM config
LLM_PROVIDER=moonshot
LLM_MODEL=moonshot-v1-8k
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=
